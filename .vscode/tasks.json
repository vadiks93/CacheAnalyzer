{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build MinimalApiWithCacheDetection",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/samples/MinimalApiWithCacheDetection/MinimalApiWithCacheDetection.csproj",
        "--configuration",
        "Debug"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build CacheAnalyzer.Sample.AspNetCore",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/samples/CacheAnalyzer.Sample.AspNetCore/CacheAnalyzer.Sample.AspNetCore.csproj",
        "--configuration",
        "Debug"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build CacheAnalyzer.Sample.NetFramework",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/samples/CacheAnalyzer.Sample.NetFramework/CacheAnalyzer.Sample.NetFramework.csproj",
        "--configuration",
        "Debug"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build CacheAnalyzerHelper.Tests",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/CacheAnalyzerHelper.Tests/CacheAnalyzerHelper.Tests.csproj",
        "--configuration",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build MinimalApiWithCacheDetection (Release)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/samples/MinimalApiWithCacheDetection/MinimalApiWithCacheDetection.csproj",
        "--configuration",
        "Release"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build CacheAnalyzer.Sample.AspNetCore (Release)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/samples/CacheAnalyzer.Sample.AspNetCore/CacheAnalyzer.Sample.AspNetCore.csproj",
        "--configuration",
        "Release"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build CacheAnalyzer.Sample.NetFramework (Release)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/samples/CacheAnalyzer.Sample.NetFramework/CacheAnalyzer.Sample.NetFramework.csproj",
        "--configuration",
        "Release"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build CacheAnalyzerHelper.Tests (Release)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/CacheAnalyzerHelper.Tests/CacheAnalyzerHelper.Tests.csproj",
        "--configuration",
        "Release",
        "--disable-build-servers"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
