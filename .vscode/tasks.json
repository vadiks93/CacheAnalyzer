{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build CacheAnalyzerHelper.Tests (LamaDebug)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/CacheAnalyzerHelper.Tests/CacheAnalyzerHelper.Tests.csproj",
        "--configuration",
        "LamaDebug",
        "--disable-build-servers"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build CacheAnalyzerHelper.Tests",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/CacheAnalyzerHelper.Tests/CacheAnalyzerHelper.Tests.csproj",
        "--configuration",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
